    "-%lld" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "-%lld" } } } },
    "%lld 行变化" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld lines changed" } } } },
    "已排队 %lld 条，本轮结束后依次发送" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld queued — sending after this turn" } } } },
    "停顿约 %lld 秒自动完成" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Auto-finishes after about %lld seconds of silence" } } } },
    "跟随系统（%@）" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Follow system (%@)" } } } },
    "需要你确认：%@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Needs your confirmation: %@" } } } },
